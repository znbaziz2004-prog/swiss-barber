<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect sensitive backend code, env files, and directories from direct HTTP access
    RewriteRule ^(\.env|\.git|backend|database|panels|website) - [F,L,NC]

    # Redirect all incoming traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
